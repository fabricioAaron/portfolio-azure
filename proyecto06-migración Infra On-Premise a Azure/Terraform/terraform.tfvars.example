# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN: RESOURCE GROUP, VNET Y APP SERVICE
# ==============================================================================

# Nombre del grupo de recursos existente o por crear
resource_group_name   = "lab-migration-onpremise"

# Región física de Azure para el despliegue (Central de España)
location              = "spaincentral"

# Nivel de tags para asignación de costes (FinOps)
tags = {
  departamento = "it"
}

# Configuración de Capa de Aplicación
app_service_plan_name = "asp-labmigrationonpremise-9657"
app_service_name      = "Ayacucho-Aventura"
